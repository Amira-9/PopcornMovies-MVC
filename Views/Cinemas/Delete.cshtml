@model Cinema
@{
    ViewData["Title"] = "Delete Cinema";
}


<div class="row text">
    <div class="col-md-8 offset-2">
        <p>
            <h1>Delete Confirmation for @Model.Name</h1>
        </p>

        <div class="row">
            <div class="col-md-8 offset-2">

                <div class="text-center mb-3">
                    <img id="LogoPreview" class="border border-info rounded-circle " style="max-width: 150px;" alt="Profile Picture Preview" />
                </div>

                <div class="mb-3">
                    <label asp-for="Logo" class="form-label"></label>
                    <input asp-for="Logo" class="form-control" readonly />
                    <span asp-validation-for="Logo" class="text-danger"></span>
                </div>


                <div class="mb-3">
                    <label asp-for="Name" class="form-label"></label>
                    <input asp-for="Name" class="form-control" readonly />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Describtion" class="form-label"></label>
                    <input asp-for="Describtion" class="form-control" readonly />
                    <span asp-validation-for="Describtion" class="text-danger"></span>
                </div>

                <div class="d-flex justify-content-between align-items-center">
                    <!-- "Show All" button aligned to the left -->
                    <a class="btn btn-outline-secondary" asp-action="Index">Show All</a>

                    <!-- "Confirm" button aligned to the right -->
                    <form asp-action="Delete" class="mb-0">
                        <input type="hidden" asp-for="Id" />
                        <input type="submit" value="Confirm" class="btn btn-danger" />
                    </form>
                </div>





            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", () => {
            const Logo = document.getElementById("Logo").value;
            const profilePicturePreview = document.getElementById("LogoPreview");
            profilePicturePreview.src = Logo;
        });
    </script>

}






