@model Producer

@{
    ViewData["Title"] = "Details of the Producer";
}

<div class="row text">
    <div class="col-md-8 offset-2">
        <h1 class="mb-4">Details for @Model.FullName</h1>

        <div class="row">
            <div class="col-md-8 offset-2">
                <!-- Profile Image -->
                <div class="form-group text-center mb-3">
                    <img class="border border-info rounded-circle" style="max-width: 150px;" id="ProfilePicturePreview" alt="Profile Picture" />
                </div>

                <!-- ProfilePictureURL -->
                <div class="form-group mb-3">
                    <label asp-for="ProfilePictureURL" class="control-label"></label>
                    <input asp-for="ProfilePictureURL" class="form-control" id="ProfilePictureURL" readonly />
                    <span asp-validation-for="ProfilePictureURL" class="text-danger"></span>
                </div>

                <!-- FullName -->
                <div class="form-group mb-3">
                    <label asp-for="FullName" class="control-label"></label>
                    <input asp-for="FullName" class="form-control" readonly />
                    <span asp-validation-for="FullName" class="text-danger"></span>
                </div>

                <!-- Bio -->
                <div class="form-group mb-4">
                    <label asp-for="Bio" class="control-label"></label>
                    <input asp-for="Bio" class="form-control" readonly />
                    <span asp-validation-for="Bio" class="text-danger"></span>
                </div>

                <!-- Buttons -->
                <div class="form-group d-flex justify-content-between">
                    @if (User.Identity.IsAuthenticated && User.IsInRole("Admin"))
                    {
                        <a class="btn btn-outline-success" asp-action="Edit" asp-route-id="@Model.Id">Edit</a>
                    }
                    <a class="btn btn-outline-secondary" asp-controller="Producers" asp-action="Index">Show All</a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", () => {
            const image = document.getElementById('ProfilePicturePreview');
            const imageUrl = document.getElementById('ProfilePictureURL').value;
            if (imageUrl) {
                image.src = imageUrl;
            }
        });
    </script>
}
