@inject UserManager<ApplicationUser> UserManager

@if(!User.Identity.IsAuthenticated)
{
    @* Authentication Links *@
    <a class="btn btn-outline-primary" asp-action="Register" asp-controller="Account">
        <i class="bi bi-person-plus"></i> Register
    </a>
    <span style="padding: 5px;"></span>

    <a class="btn btn-outline-success" asp-action="Login" asp-controller="Account">
        <i class="bi bi-box-arrow-in-right"></i> Login
    </a>
}
else
{
    @* User Profile Section *@
    <div class="dropdown">
        <button class="btn btn-outline-success dropdown-toggle" type="button" id="profile-btn" data-bs-toggle="dropdown" aria-expanded="false">
            <i class="bi bi-person-badge"></i> Hello @UserManager.GetUserName(User)
        </button>
        <ul class="dropdown-menu" aria-labelledby="profile-btn">
            <li>
                <a class="dropdown-item" asp-controller="Orders" asp-action="Index">
                    <i class="bi bi-list"></i> Orders
                </a>
            </li>

            @if(User.IsInRole("Admin")){
                <li>
                    <a class="dropdown-item" asp-controller="Account" asp-action="Users">
                        <i class="bi bi-people"></i> Users
                    </a>
                </li>
            }
        </ul>
    </div>

    <span style="padding: 5px;"></span>

    <form asp-controller="Account" asp-action="Logout">
        <button class="btn btn-outline-danger my-2 my-sm-0">
            <i class="bi bi-box-arrow-in-right"></i> Log out
        </button>
    </form>

}

